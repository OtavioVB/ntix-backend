# Copie para devops/.env (ignorado pelo Git) e defina uma senha local.
# O SQL Server exige ao menos 8 caracteres, com maiúsculas, minúsculas, números e símbolos.
MSSQL_SA_PASSWORD=
# Chave privada combinada ao hash das senhas dos clientes. Gere com: openssl rand -base64 32
PASSWORD_PRIVATE_KEY=
# Chave que assina os tokens JWT, com ao menos 32 bytes. Gere com: openssl rand -base64 32
JWT_SECRET_KEY=
# Chave de API da Resend, que envia os emails de verificação.
RESEND_API_KEY=
# Remetente dos emails, de um domínio verificado na Resend. Exemplo: Ntix <nao-responda@seudominio.com>
RESEND_FROM=
# Página que recebe o link de verificação, sem query string. O token é enviado em ?token=
EMAIL_VERIFICATION_LINK_BASE_URL=
