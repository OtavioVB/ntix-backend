# Copie para devops/.env (ignorado pelo Git) e defina uma senha local.
# Senha do usuário ntix do PostgreSQL. Não use ' nem ;, porque ela compõe a connection string.
POSTGRES_PASSWORD=
# Chave privada combinada ao hash das senhas dos clientes. Gere com: openssl rand -base64 32
PASSWORD_PRIVATE_KEY=
# Chave AES-256 que cifra as credenciais das integrações de pagamento (REQ4): 32 bytes em Base64.
# Gere com: openssl rand -base64 32. Perdê-la torna as credenciais gravadas ilegíveis: guarde um backup.
PAYMENT_CREDENTIAL_ENCRYPTION_KEY=
# Chave HMAC-SHA256 do access token do usuário do produtor (REQ5): 32 bytes ou mais em Base64.
# Gere com: openssl rand -base64 32
JWT_SIGNING_KEY=
# Opcionais: só para subir o PgAdmin (docker compose --profile pgadmin), em http://localhost:5050.
# Login do PgAdmin (e-mail válido e senha), definido na primeira subida do volume.
PGADMIN_EMAIL=
PGADMIN_PASSWORD=
# Senha do usuário ntix_pgadmin do PostgreSQL, usada pelo PgAdmin. Vazia: o usuário não é criado.
PGADMIN_DATABASE_PASSWORD=
