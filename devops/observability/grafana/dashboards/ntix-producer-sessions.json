{
  "uid": "ntix-producer-sessions",
  "title": "Ntix Sessões do Produtor",
  "description": "Acompanhamento de negócio do login, da renovação e do logout do usuário da produtora (REQ5), com recusas por motivo e reusos de refresh token.",
  "tags": [
    "ntix",
    "negocio",
    "funil",
    "seguranca"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Serviço",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(ntix_producers_sessions_creation_requests_total, service_name)",
          "refId": "service"
        },
        "definition": "label_values(ntix_producers_sessions_creation_requests_total, service_name)",
        "refresh": 2,
        "current": {
          "text": "ntix-webapi",
          "value": "ntix-webapi"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Login (resumo do período)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Logins solicitados",
      "description": "Toda tentativa que chegou ao caso de uso.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "round(sum(increase(ntix_producers_sessions_creation_requests_total{service_name=\"$service\"}[$__range]))) or vector(0)"
        }
      ]
    },
