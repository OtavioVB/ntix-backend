{
  "uid": "ntix-orders",
  "title": "Ntix Pedidos",
  "description": "REQ6: criação do pedido com reserva de ingressos, consulta pelo código e espera pela trava dos lotes.",
  "tags": [
    "ntix",
    "negocio",
    "funil",
    "pedidos"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Serviço",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(ntix_orders_create_requests_total, service_name)",
          "refId": "service"
        },
        "definition": "label_values(ntix_orders_create_requests_total, service_name)",
        "refresh": 2,
        "current": {
          "text": "ntix-webapi",
          "value": "ntix-webapi"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Solicitações no período: criação do pedido",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "round(sum(increase(ntix_orders_create_requests_total{service_name=\"$service\"}[$__range])))"
        }
      ]
    },
    {
