{
  "uid": "ntix-webapi",
  "title": "Ntix WebApi",
  "description": "HTTP (tráfego, latência, erros), concorrência, runtime .NET, logs e traces da WebApi via OpenTelemetry.",
  "tags": ["ntix", "opentelemetry"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Serviço",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(http_server_request_duration_seconds_count, service_name)", "refId": "service" },
        "definition": "label_values(http_server_request_duration_seconds_count, service_name)",
        "refresh": 2,
        "current": { "text": "ntix-webapi", "value": "ntix-webapi" }
      },
      {
        "name": "route",
        "label": "Rota",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(http_server_request_duration_seconds_count{service_name=\"$service\"}, http_route)", "refId": "route" },
        "definition": "label_values(http_server_request_duration_seconds_count{service_name=\"$service\"}, http_route)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "correlation_id",
        "label": "X-Correlation-Id",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    { "type": "row", "title": "Visão geral", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "panels": [] },
    {
      "type": "stat",
      "title": "Requisições/s",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area", "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2, "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_server_request_duration_seconds_count{service_name=\"$service\", http_route=~\"$route\"}[$__rate_interval])) or vector(0)" }
      ]
    },
    {
      "type": "stat",
      "title": "Requisições no período",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 3, "x": 3, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "targets": [
        { "refId": "A", "instant": true, "expr": "round(sum(increase(http_server_request_duration_seconds_count{service_name=\"$service\", http_route=~\"$route\"}[$__range]))) or vector(0)" }
      ]
    },
    {
      "type": "stat",
      "title": "Latência média",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 3, "x": 6, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area", "colorMode": "value" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.3 }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_server_request_duration_seconds_sum{service_name=\"$service\", http_route=~\"$route\"}[$__rate_interval])) / (sum(rate(http_server_request_duration_seconds_count{service_name=\"$service\", http_route=~\"$route\"}[$__rate_interval])) > 0)" }
      ]
    },
    {
      "type": "stat",
      "title": "Latência p95",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 3, "x": 9, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area", "colorMode": "value" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.5 }, { "color": "red", "value": 2 } ] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"$service\", http_route=~\"$route\"}[$__rate_interval])))" }
      ]
    },
    {
      "type": "stat",
      "title": "Taxa de erro (5xx)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 3, "x": 12, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area", "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.01 }, { "color": "red", "value": 0.05 } ] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "((sum(rate(http_server_request_duration_seconds_count{service_name=\"$service\", http_route=~\"$route\", http_response_status_code=~\"5..\"}[$__rate_interval])) or vector(0)) / (sum(rate(http_server_request_duration_seconds_count{service_name=\"$service\", http_route=~\"$route\"}[$__rate_interval])) > 0)) or vector(0)" }
      ]
    },
    {
      "type": "stat",
      "title": "Taxa de erro do cliente (4xx)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 3, "x": 15, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area", "colorMode": "value" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.1 }, { "color": "red", "value": 0.3 } ] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "((sum(rate(http_server_request_duration_seconds_count{service_name=\"$service\", http_route=~\"$route\", http_response_status_code=~\"4..\"}[$__rate_interval])) or vector(0)) / (sum(rate(http_server_request_duration_seconds_count{service_name=\"$service\", http_route=~\"$route\"}[$__rate_interval])) > 0)) or vector(0)" }
      ]
    },
    {
      "type": "stat",
      "title": "Respostas 400 no período",
      "description": "Inclui requisições rejeitadas por headers auditáveis ausentes ou inválidos.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 3, "x": 18, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "orange" } }, "overrides": [] },
      "targets": [
        { "refId": "A", "instant": true, "expr": "round(sum(increase(http_server_request_duration_seconds_count{service_name=\"$service\", http_route=~\"$route\", http_response_status_code=\"400\"}[$__range]))) or vector(0)" }
      ]
    },
    {
      "type": "stat",
      "title": "Requisições em andamento",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 3, "x": 21, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area", "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "purple" } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(http_server_active_requests{service_name=\"$service\"}) or vector(0)" }
      ]
    },

    { "type": "row", "title": "Tráfego", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }, "panels": [] },
    {
      "type": "timeseries",
      "title": "Requisições por segundo (método / rota / status)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_request_method, http_route, http_response_status_code) (rate(http_server_request_duration_seconds_count{service_name=\"$service\", http_route=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "{{http_request_method}} {{http_route}} {{http_response_status_code}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Respostas por status code",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "bars", "fillOpacity": 80, "stacking": { "mode": "normal" } } },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "2.." }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byRegexp", "options": "4.." }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] },
          { "matcher": { "id": "byRegexp", "options": "5.." }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{service_name=\"$service\", http_route=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "{{http_response_status_code}}"
        }
      ]
    },

    { "type": "row", "title": "Latência", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }, "panels": [] },
    {
      "type": "timeseries",
      "title": "Latência (média / p50 / p95 / p99)",
      "description": "Os pontos (exemplars) da p95 levam ao trace no Tempo.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_sum{service_name=\"$service\", http_route=~\"$route\"}[$__rate_interval])) / (sum(rate(http_server_request_duration_seconds_count{service_name=\"$service\", http_route=~\"$route\"}[$__rate_interval])) > 0)",
          "legendFormat": "média"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"$service\", http_route=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"$service\", http_route=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "exemplar": true
        },
        {
          "refId": "D",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"$service\", http_route=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latência média por rota",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_request_method, http_route) (rate(http_server_request_duration_seconds_sum{service_name=\"$service\", http_route=~\"$route\"}[$__rate_interval])) / (sum by (http_request_method, http_route) (rate(http_server_request_duration_seconds_count{service_name=\"$service\", http_route=~\"$route\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{http_request_method}} {{http_route}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latência p95 por rota",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, http_request_method, http_route) (rate(http_server_request_duration_seconds_bucket{service_name=\"$service\", http_route=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "{{http_request_method}} {{http_route}}"
        }
      ]
    },
    {
      "type": "heatmap",
      "title": "Distribuição da latência",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": { "mode": "scheme", "scheme": "Oranges", "steps": 64 },
        "yAxis": { "unit": "s" },
        "tooltip": { "mode": "single", "yHistogram": true },
        "legend": { "show": true }
      },
      "targets": [
        {
          "refId": "A",
          "format": "heatmap",
          "expr": "sum by (le) (increase(http_server_request_duration_seconds_bucket{service_name=\"$service\", http_route=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "{{le}}"
        }
      ]
    },

    { "type": "row", "title": "Erros", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 }, "panels": [] },
    {
      "type": "timeseries",
      "title": "Taxa de erro (4xx / 5xx)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "fillOpacity": 15 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "4xx" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] },
          { "matcher": { "id": "byName", "options": "5xx" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_server_request_duration_seconds_count{service_name=\"$service\", http_route=~\"$route\", http_response_status_code=~\"4..\"}[$__rate_interval])) or vector(0)) / (sum(rate(http_server_request_duration_seconds_count{service_name=\"$service\", http_route=~\"$route\"}[$__rate_interval])) > 0)",
          "legendFormat": "4xx"
        },
        {
          "refId": "B",
          "expr": "(sum(rate(http_server_request_duration_seconds_count{service_name=\"$service\", http_route=~\"$route\", http_response_status_code=~\"5..\"}[$__rate_interval])) or vector(0)) / (sum(rate(http_server_request_duration_seconds_count{service_name=\"$service\", http_route=~\"$route\"}[$__rate_interval])) > 0)",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Exceções por segundo",
      "description": "Exceções lançadas no runtime .NET por tipo e requisições terminadas com exceção não tratada.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 60 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (error_type) (rate(dotnet_exceptions_total{service_name=\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{error_type}}"
        },
        {
          "refId": "B",
          "expr": "sum(rate(http_server_request_duration_seconds_count{service_name=\"$service\", aspnetcore_request_is_unhandled=\"true\"}[$__rate_interval]))",
          "legendFormat": "requisições com exceção não tratada"
        }
      ]
    },

    { "type": "row", "title": "Concorrência e conexões", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 40 }, "panels": [] },
    {
      "type": "timeseries",
      "title": "Requisições em andamento por método",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 41 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "min": 0, "custom": { "fillOpacity": 15 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (http_request_method) (http_server_active_requests{service_name=\"$service\"})", "legendFormat": "{{http_request_method}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Kestrel: conexões e filas",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 41 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(kestrel_active_connections{service_name=\"$service\"})", "legendFormat": "conexões ativas" },
        { "refId": "B", "expr": "sum(kestrel_queued_connections{service_name=\"$service\"})", "legendFormat": "conexões na fila" },
        { "refId": "C", "expr": "sum(kestrel_queued_requests{service_name=\"$service\"})", "legendFormat": "requisições na fila" }
      ]
    },

    { "type": "row", "title": "Runtime .NET", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 48 }, "panels": [] },
    {
      "type": "timeseries",
      "title": "Memória",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 49 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(dotnet_process_memory_working_set_bytes{service_name=\"$service\"})", "legendFormat": "working set" },
        { "refId": "B", "expr": "sum(dotnet_gc_last_collection_memory_committed_size_bytes{service_name=\"$service\"})", "legendFormat": "GC committed" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Heap por geração (última coleta)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 49 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 30, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (gc_heap_generation) (dotnet_gc_last_collection_heap_size_bytes{service_name=\"$service\"})", "legendFormat": "{{gc_heap_generation}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU (% da máquina)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 49 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "custom": { "fillOpacity": 15 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(dotnet_process_cpu_time_seconds_total{service_name=\"$service\"}[$__rate_interval])) / max(dotnet_process_cpu_count{service_name=\"$service\"})", "legendFormat": "cpu" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Taxa de alocação",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 49 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "fillOpacity": 15 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(dotnet_gc_heap_allocated_bytes_total{service_name=\"$service\"}[$__rate_interval]))", "legendFormat": "alocado/s" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Coletas de GC por geração",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 56 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (gc_heap_generation) (increase(dotnet_gc_collections_total{service_name=\"$service\"}[$__rate_interval]))", "legendFormat": "{{gc_heap_generation}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tempo em pausa de GC",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 56 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "custom": { "fillOpacity": 15 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(dotnet_gc_pause_time_seconds_total{service_name=\"$service\"}[$__rate_interval]))", "legendFormat": "% do tempo em pausa" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Thread pool",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 56 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(dotnet_thread_pool_thread_count_total{service_name=\"$service\"})", "legendFormat": "threads" },
        { "refId": "B", "expr": "sum(dotnet_thread_pool_queue_length_total{service_name=\"$service\"})", "legendFormat": "itens na fila" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Contenção de lock e work items",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 56 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(dotnet_monitor_lock_contentions_total{service_name=\"$service\"}[$__rate_interval]))", "legendFormat": "contenções/s" },
        { "refId": "B", "expr": "sum(rate(dotnet_thread_pool_work_item_count_total{service_name=\"$service\"}[$__rate_interval]))", "legendFormat": "work items/s" }
      ]
    },

    { "type": "row", "title": "Logs e traces", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 63 }, "panels": [] },
    {
      "type": "timeseries",
      "title": "Volume de logs por nível",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 64 },
      "options": { "legend": { "displayMode": "list", "placement": "right" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 70, "stacking": { "mode": "normal" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Warning" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] },
          { "matcher": { "id": "byName", "options": "Error" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] },
          { "matcher": { "id": "byName", "options": "Critical" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "dark-red" } } ] }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (severity_text) (count_over_time({service_name=\"$service\"} | CorrelationId=~\".*$correlation_id.*\" [$__auto]))",
          "legendFormat": "{{severity_text}}"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Logs (filtre por X-Correlation-Id no topo)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 70 },
      "options": { "showTime": true, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending", "dedupStrategy": "none" },
      "targets": [
        { "refId": "A", "expr": "{service_name=\"$service\"} | CorrelationId=~\".*$correlation_id.*\"" }
      ]
    },
    {
      "type": "table",
      "title": "Traces recentes",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 82 },
      "targets": [
        { "refId": "A", "queryType": "traceql", "query": "{resource.service.name=\"$service\"}", "limit": 20 }
      ]
    },
    {
      "type": "table",
      "title": "Traces com erro ou lentos (> 500ms)",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 82 },
      "targets": [
        { "refId": "A", "queryType": "traceql", "query": "{resource.service.name=\"$service\" && (status = error || duration > 500ms)}", "limit": 20 }
      ]
    }
  ]
}
