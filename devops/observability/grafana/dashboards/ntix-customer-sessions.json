{
  "uid": "ntix-customer-sessions",
  "title": "Ntix Sessões do Cliente",
  "description": "REQ12: login, renovação, logout e meus dados do comprador.",
  "tags": [
    "ntix",
    "negocio",
    "funil",
    "clientes"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Serviço",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(ntix_customers_sessions_create_requests_total, service_name)",
          "refId": "service"
        },
        "definition": "label_values(ntix_customers_sessions_create_requests_total, service_name)",
        "refresh": 2,
        "current": {
          "text": "ntix-webapi",
          "value": "ntix-webapi"
        }
      }
    ]
  },
