{
  "uid": "ntix-producer-registration-funnel",
  "title": "Ntix Funil de Cadastro de Produtora",
  "description": "Acompanhamento de negócio: das solicitações de cadastro até as contas criadas, com os motivos de saída do funil.",
  "tags": ["ntix", "negocio", "funil"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Serviço",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(ntix_producers_registration_requests_total, service_name)", "refId": "service" },
        "definition": "label_values(ntix_producers_registration_requests_total, service_name)",
        "refresh": 2,
        "current": { "text": "ntix-webapi", "value": "ntix-webapi" }
      }
    ]
  },
  "panels": [
    { "type": "row", "title": "Resumo do período", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "panels": [] },
    {
      "type": "stat",
      "title": "Solicitações de cadastro",
      "description": "Passo 1: toda solicitação que chegou ao caso de uso.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "targets": [
        { "refId": "A", "instant": true, "expr": "round(sum(increase(ntix_producers_registration_requests_total{service_name=\"$service\"}[$__range]))) or vector(0)" }
      ]
    },
    {
      "type": "stat",
      "title": "Contas criadas",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] },
      "targets": [
        { "refId": "A", "instant": true, "expr": "round(sum(increase(ntix_producers_registration_outcomes_total{service_name=\"$service\", outcome=\"created\"}[$__range]))) or vector(0)" }
      ]
    },
    {
      "type": "stat",
      "title": "Pararam na validação inicial",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "orange" } }, "overrides": [] },
      "targets": [
        { "refId": "A", "instant": true, "expr": "round(sum(increase(ntix_producers_registration_outcomes_total{service_name=\"$service\", outcome=\"validation_failed\"}[$__range]))) or vector(0)" }
      ]
    },
    {
      "type": "stat",
      "title": "Já existiam na base",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "yellow" } }, "overrides": [] },
      "targets": [
        { "refId": "A", "instant": true, "expr": "round(sum(increase(ntix_producers_registration_outcomes_total{service_name=\"$service\", outcome=\"already_exists\"}[$__range]))) or vector(0)" }
      ]
    },
    {
      "type": "stat",
      "title": "Erros por exceção",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "instant": true, "expr": "round(sum(increase(ntix_producers_registration_outcomes_total{service_name=\"$service\", outcome=\"error\"}[$__range]))) or vector(0)" }
      ]
    },
    {
      "type": "stat",
      "title": "Conversão",
      "description": "Contas criadas sobre solicitações de cadastro.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "colorMode": "value" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "color": { "mode": "fixed", "fixedColor": "green" }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "instant": true, "expr": "(sum(increase(ntix_producers_registration_outcomes_total{service_name=\"$service\", outcome=\"created\"}[$__range])) or vector(0)) / (sum(increase(ntix_producers_registration_requests_total{service_name=\"$service\"}[$__range])) > 0)" }
      ]
    },

    { "type": "row", "title": "Funil", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 }, "panels": [] },
    {
      "type": "bargauge",
      "title": "Funil de cadastro",
      "description": "Passo 1: solicitações. Passo 2: para onde cada solicitação foi.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 11, "w": 14, "x": 0, "y": 7 },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "min": 0, "color": { "mode": "fixed", "fixedColor": "blue" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Contas criadas" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byName", "options": "Pararam na validação inicial" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] },
          { "matcher": { "id": "byName", "options": "Já existiam na base" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } } ] },
          { "matcher": { "id": "byName", "options": "Erros por exceção" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
        ]
      },
      "targets": [
        { "refId": "A", "instant": true, "legendFormat": "Solicitações de cadastro", "expr": "round(sum(increase(ntix_producers_registration_requests_total{service_name=\"$service\"}[$__range]))) or vector(0)" },
        { "refId": "B", "instant": true, "legendFormat": "Pararam na validação inicial", "expr": "round(sum(increase(ntix_producers_registration_outcomes_total{service_name=\"$service\", outcome=\"validation_failed\"}[$__range]))) or vector(0)" },
        { "refId": "C", "instant": true, "legendFormat": "Já existiam na base", "expr": "round(sum(increase(ntix_producers_registration_outcomes_total{service_name=\"$service\", outcome=\"already_exists\"}[$__range]))) or vector(0)" },
        { "refId": "D", "instant": true, "legendFormat": "Erros por exceção", "expr": "round(sum(increase(ntix_producers_registration_outcomes_total{service_name=\"$service\", outcome=\"error\"}[$__range]))) or vector(0)" },
        { "refId": "E", "instant": true, "legendFormat": "Contas criadas", "expr": "round(sum(increase(ntix_producers_registration_outcomes_total{service_name=\"$service\", outcome=\"created\"}[$__range]))) or vector(0)" }
      ]
    },
    {
      "type": "bargauge",
      "title": "Participação de cada desfecho nas solicitações",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 11, "w": 10, "x": 14, "y": 7 },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "top",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "decimals": 1, "min": 0, "max": 1, "color": { "mode": "fixed", "fixedColor": "blue" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Contas criadas" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byName", "options": "Pararam na validação inicial" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] },
          { "matcher": { "id": "byName", "options": "Já existiam na base" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } } ] },
          { "matcher": { "id": "byName", "options": "Erros por exceção" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
        ]
      },
      "targets": [
        { "refId": "A", "instant": true, "legendFormat": "Contas criadas", "expr": "(sum(increase(ntix_producers_registration_outcomes_total{service_name=\"$service\", outcome=\"created\"}[$__range])) or vector(0)) / (sum(increase(ntix_producers_registration_requests_total{service_name=\"$service\"}[$__range])) > 0)" },
        { "refId": "B", "instant": true, "legendFormat": "Pararam na validação inicial", "expr": "(sum(increase(ntix_producers_registration_outcomes_total{service_name=\"$service\", outcome=\"validation_failed\"}[$__range])) or vector(0)) / (sum(increase(ntix_producers_registration_requests_total{service_name=\"$service\"}[$__range])) > 0)" },
        { "refId": "C", "instant": true, "legendFormat": "Já existiam na base", "expr": "(sum(increase(ntix_producers_registration_outcomes_total{service_name=\"$service\", outcome=\"already_exists\"}[$__range])) or vector(0)) / (sum(increase(ntix_producers_registration_requests_total{service_name=\"$service\"}[$__range])) > 0)" },
        { "refId": "D", "instant": true, "legendFormat": "Erros por exceção", "expr": "(sum(increase(ntix_producers_registration_outcomes_total{service_name=\"$service\", outcome=\"error\"}[$__range])) or vector(0)) / (sum(increase(ntix_producers_registration_requests_total{service_name=\"$service\"}[$__range])) > 0)" }
      ]
    },

    { "type": "row", "title": "Evolução no tempo", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 }, "panels": [] },
    {
      "type": "timeseries",
      "title": "Desfechos por intervalo",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 19 },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 80, "stacking": { "mode": "normal" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Contas criadas" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byName", "options": "Pararam na validação inicial" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] },
          { "matcher": { "id": "byName", "options": "Já existiam na base" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } } ] },
          { "matcher": { "id": "byName", "options": "Erros por exceção" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
        ]
      },
      "targets": [
        { "refId": "A", "legendFormat": "Contas criadas", "expr": "sum(increase(ntix_producers_registration_outcomes_total{service_name=\"$service\", outcome=\"created\"}[$__rate_interval]))" },
        { "refId": "B", "legendFormat": "Pararam na validação inicial", "expr": "sum(increase(ntix_producers_registration_outcomes_total{service_name=\"$service\", outcome=\"validation_failed\"}[$__rate_interval]))" },
        { "refId": "C", "legendFormat": "Já existiam na base", "expr": "sum(increase(ntix_producers_registration_outcomes_total{service_name=\"$service\", outcome=\"already_exists\"}[$__rate_interval]))" },
        { "refId": "D", "legendFormat": "Erros por exceção", "expr": "sum(increase(ntix_producers_registration_outcomes_total{service_name=\"$service\", outcome=\"error\"}[$__rate_interval]))" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Solicitações e contas criadas por segundo",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 19 },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0, "custom": { "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Solicitações" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } } ] },
          { "matcher": { "id": "byName", "options": "Contas criadas" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] }
        ]
      },
      "targets": [
        { "refId": "A", "legendFormat": "Solicitações", "expr": "sum(rate(ntix_producers_registration_requests_total{service_name=\"$service\"}[$__rate_interval]))" },
        { "refId": "B", "legendFormat": "Contas criadas", "expr": "sum(rate(ntix_producers_registration_outcomes_total{service_name=\"$service\", outcome=\"created\"}[$__rate_interval]))" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Conversão ao longo do tempo",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "color": { "mode": "fixed", "fixedColor": "green" }, "custom": { "fillOpacity": 15 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "conversão", "expr": "(sum(rate(ntix_producers_registration_outcomes_total{service_name=\"$service\", outcome=\"created\"}[$__rate_interval])) or vector(0)) / (sum(rate(ntix_producers_registration_requests_total{service_name=\"$service\"}[$__rate_interval])) > 0)" }
      ]
    },
    {
      "type": "stat",
      "title": "Sem desfecho no período",
      "description": "Solicitações menos desfechos: cancelamentos pelo cliente e cadastros em andamento. O valor é aproximado, porque o increase() do Prometheus extrapola as amostras.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "min": 0, "color": { "mode": "fixed", "fixedColor": "purple" } }, "overrides": [] },
      "targets": [
        { "refId": "A", "instant": true, "expr": "clamp_min(round((sum(increase(ntix_producers_registration_requests_total{service_name=\"$service\"}[$__range])) or vector(0)) - (sum(increase(ntix_producers_registration_outcomes_total{service_name=\"$service\"}[$__range])) or vector(0))), 0)" }
      ]
    },

    { "type": "row", "title": "Investigação", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 }, "panels": [] },
    {
      "type": "logs",
      "title": "Logs do cadastro de produtora",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 11, "w": 24, "x": 0, "y": 37 },
      "options": { "showTime": true, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending", "dedupStrategy": "none" },
      "targets": [
        { "refId": "A", "expr": "{service_name=\"$service\"} | scope_name=\"Application.UseCases.CreateCustomer.CreateCustomerUseCase\"" }
      ]
    },
    {
      "type": "table",
      "title": "Cadastros com erro por exceção (traces)",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 48 },
      "targets": [
        { "refId": "A", "queryType": "traceql", "query": "{resource.service.name=\"$service\" && name=\"CreateCustomer\" && span.ntix.outcome=\"error\"}", "limit": 20 }
      ]
    },
    {
      "type": "table",
      "title": "Cadastros recentes (traces)",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 48 },
      "targets": [
        { "refId": "A", "queryType": "traceql", "query": "{resource.service.name=\"$service\" && name=\"CreateCustomer\"}", "limit": 20 }
      ]
    },

    { "type": "row", "title": "Definição da senha", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 58 }, "panels": [] },
    {
      "type": "stat",
      "title": "Tempo das iterações de hash (p95)",
      "description": "Amarelo a partir de 250 ms e vermelho a partir de 500 ms, o limite de p95 do cadastro inteiro.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 59 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.25 }, { "color": "red", "value": 0.5 } ] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "instant": true, "expr": "histogram_quantile(0.95, sum by (le) (rate(ntix_producers_password_hash_duration_seconds_bucket{service_name=\"$service\"}[$__range])))" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tempo das iterações de hash ao longo do tempo",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 59 },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "fillOpacity": 10, "thresholdsStyle": { "mode": "line" } },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.25 }, { "color": "red", "value": 0.5 } ] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "legendFormat": "p50", "expr": "histogram_quantile(0.50, sum by (le) (rate(ntix_producers_password_hash_duration_seconds_bucket{service_name=\"$service\"}[$__rate_interval])))" },
        { "refId": "B", "legendFormat": "p95", "expr": "histogram_quantile(0.95, sum by (le) (rate(ntix_producers_password_hash_duration_seconds_bucket{service_name=\"$service\"}[$__rate_interval])))" }
      ]
    }
  ]
}
