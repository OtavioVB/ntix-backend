{
  "uid": "ntix-payments",
  "title": "Ntix Pagamentos",
  "description": "REQ7: geração do Pix do pedido, fallback entre integrações e saúde do fornecedor.",
  "tags": [
    "ntix",
    "negocio",
    "funil",
    "pagamentos"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
