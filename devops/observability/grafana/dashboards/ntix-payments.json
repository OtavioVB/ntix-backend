    "from": "now-24h",
    "to": "now"
  },
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Serviço",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(ntix_payments_pix_create_requests_total, service_name)",
          "refId": "service"
        },
        "definition": "label_values(ntix_payments_pix_create_requests_total, service_name)",
        "refresh": 2,
        "current": {
          "text": "ntix-webapi",
          "value": "ntix-webapi"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Solicitações no período: geração do Pix",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "round(sum(increase(ntix_payments_pix_create_requests_total{service_name=\"$service\"}[$__range])))"
        }
      ]
    },
    {
