{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "IncludeScopes": true
    }
  },
  "AllowedHosts": "*",
  "WhitelabelConfiguration": {
    "DirectoryPath": "/app/whitelabel"
  },
  "JwtConfiguration": {
    "Issuer": "https://api.ntix.com.br",
    "Audience": "ntix-producer-panel",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "LoginAttemptConfiguration": {
    "PermitLimit": 10,
    "WindowMinutes": 15
  },
  "OrderConfiguration": {
    "MaxTicketsPerOrder": 6
  },
  "CorsConfiguration": {
    "AllowedOrigins": [
      "https://produtores.ntix.com.br",
      "https://ntix.com.br",
      "https://www.ntix.com.br",
      "https://localhost:5173"
    ]
  }
}
